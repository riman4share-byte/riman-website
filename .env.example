# ============================================================================
# Riman Fashion environment reference
#
# THREE kinds of variables - do not mix them up:
#   1. CLIENT  (VITE_*): baked into the public JS bundle at BUILD time.
#      Anything secret NEVER goes here (Vite only exposes VITE_* to the
#      browser; but "public" is still true even when a value looks private).
#   2. BUILD   : consumed by vite/Docker at build time (SITE_URL).
#   3. SERVER-ONLY: Supabase Edge Function secrets (set via
#      `supabase secrets set`, or supabase/.env for local `functions serve`).
#      These have no VITE_ prefix and are never readable from the browser.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Client (public) - copy to .env.local for development
# ----------------------------------------------------------------------------

# Supabase project (anon key is safe ONLY because RLS enforces authorization)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge function endpoints (OPTIONAL — since 2026-09-16 hardening they are
# derived automatically from VITE_SUPABASE_URL as <url>/functions/v1/<name>;
# set these only to override, e.g. a staging proxy).
# VITE_STRIPE_CHECKOUT_ENDPOINT=https://your-project.supabase.co/functions/v1/create-checkout
# VITE_CREATE_ORDER_ENDPOINT=https://your-project.supabase.co/functions/v1/create-order
# After any change to the pair above: npm run verify:env (catches mismatched
# or rotated keys — the exact failure that broke login on 2026-09-16).

# Error monitoring (optional; Sentry stays disabled without it)
VITE_SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456

# Admin notification inbox for delegated emails (optional)
VITE_ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# Bot protection (optional; login works without Turnstile configured)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx

# Admin second factor enforcement (false until enrolled at /admin)
VITE_REQUIRE_ADMIN_MFA=false

# Analytics IDs (GA / Plausible / Fathom) are configured in the admin panel
# at runtime, not via env.

# ----------------------------------------------------------------------------
# 2. Build-time (required for production builds; used by SEO/sitemap/prerender)
# ----------------------------------------------------------------------------

# Absolute https origin of the deployed site. `npm run build` FAILS without
# it. Local dev/preview defaults to http://localhost:3001.
SITE_URL=https://riman.ae

# ----------------------------------------------------------------------------
# 3. SERVER-ONLY secrets - Supabase Edge Functions
#    (supabase secrets set KEY=value; never add VITE_ prefix, never commit)
# ----------------------------------------------------------------------------

# Stripe (secret keys are server-side only; checkout is created in
# create-checkout and verified in stripe-webhook)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Must match the client SITE_URL (success/cancel URL construction)
SITE_URL=https://riman.ae

# Comma-separated origins allowed as checkout return URLs
ALLOWED_SITE_ORIGINS=https://riman.ae,https://www.riman.ae

# Transactional email (used by send-notification edge function only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Atelier Riman <orders@yourdomain.com>

# Cloudflare Turnstile secret (validated server-side on login if enabled)
TURNSTILE_SECRET_KEY=0x4AAAAAAAyyyyyyyyyyyyyyyy
